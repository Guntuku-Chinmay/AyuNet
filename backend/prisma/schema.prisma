  updatedBy   String?   @map("updated_by") @db.Uuid
  deletedBy   String?   @map("deleted_by") @db.Uuid

  @@map("system_settings")
}

model Invoice {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId       String        @map("patient_id") @db.Uuid
  payerType       PayerType     @map("payer_type")
  invoiceNumber   String        @map("invoice_number")
  subtotal        Decimal       @db.Decimal(10, 2)
  tax             Decimal       @db.Decimal(10, 2)
  discount        Decimal       @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  status          InvoiceStatus @default(DRAFT)
  dueDate         DateTime      @map("due_date") @db.Date
  appointmentId   String?       @map("appointment_id") @db.Uuid
  pharmacyOrderId String?       @unique @map("pharmacy_order_id") @db.Uuid
  labOrderId      String?       @map("lab_order_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")
  createdBy       String?       @map("created_by") @db.Uuid
  updatedBy       String?       @map("updated_by") @db.Uuid
  deletedBy       String?       @map("deleted_by") @db.Uuid

  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  pharmacyOrder PharmacyOrder? @relation(fields: [pharmacyOrderId], references: [id], onDelete: Restrict)
  labOrder      LabOrder?      @relation(fields: [labOrderId], references: [id], onDelete: Restrict)
  payments      Payment[]
  transactions  Transaction[]

  @@map("invoices")
}

model Payment {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId          String        @map("invoice_id") @db.Uuid
  amount             Decimal       @db.Decimal(10, 2)
  currency           String        @default("INR")
  status             PaymentStatus @default(PENDING)
  paymentGateway     String        @map("payment_gateway")
  gatewayReferenceId String        @map("gateway_reference_id")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  deletedAt          DateTime?     @map("deleted_at")
  createdBy          String?       @map("created_by") @db.Uuid
  updatedBy          String?       @map("updated_by") @db.Uuid
  deletedBy          String?       @map("deleted_by") @db.Uuid

  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@map("payments")
}

model Transaction {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId            String?         @map("payment_id") @db.Uuid
  invoiceId            String          @map("invoice_id") @db.Uuid
  transactionType      TransactionType @map("transaction_type")
  amount               Decimal         @db.Decimal(10, 2)
  currency             String          @default("INR")
  status               String
  gatewayTransactionId String?         @map("gateway_transaction_id")
  createdAt            DateTime        @default(now()) @map("created_at")
  createdBy            String?         @map("created_by") @db.Uuid

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@map("transactions")
}
