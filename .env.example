# AyuNet Environment Configuration

# PostgreSQL Configuration (used by Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=ayunet_dev
POSTGRES_PORT=5432

# Backend Configurations
PORT=4000
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/ayunet_dev?schema=public"

# Frontend Configurations
PATIENT_WEB_PORT=3000
DOCTOR_WEB_PORT=3001
ADMIN_WEB_PORT=3002
