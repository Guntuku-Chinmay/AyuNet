datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NOSHOW
}

enum VisitType {
  OUTPATIENT
  INPATIENT
  EMERGENCY
  TELEVISIT
}

enum VisitStatus {
  ACTIVE
  COMPLETED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum DocumentStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  EXPIRED
}

enum DocumentType {
  MED_LICENSE
  REGISTRATION_CERTIFICATE
  PATIENT_ID
  INSURANCE_CARD
}

enum MedicineForm {
  TABLET
  CAPSULE
  SYRUP
  INJECTION
  CREAM
  OINTMENT
  OTHER
}

enum RoomStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum RoomType {
  ICU
  GENERAL_WARD
  PRIVATE
  SEMIPRIVATE
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum AllergyType {
  DRUG
  FOOD
  ENVIRONMENTAL
  OTHER
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
  LIFE_THREATENING
}

enum AllergyStatus {
  ACTIVE
  INACTIVE
  RESOLVED
}

enum ConditionStatus {
  ACTIVE
  CONTROLLED
  REMISSION
}

enum PrescriptionStatus {
  DRAFT
  SIGNED
  DISPENSED
  COMPLETED
  EXPIRED
}

enum LabOrderStatus {
  PLACED
  SAMPLE_COLLECTED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum LabReportStatus {
  PRELIMINARY
  FINAL
  AMENDED
}

enum PharmacyOrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PayerType {
  PATIENT
  INSURANCE
  SPONSOR
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum TransactionType {
  CHARGE
  REFUND
  ADJUSTMENT
}

// ==========================================
// MODELS
// ==========================================

model Address {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  addressLine1 String    @map("address_line1")
  addressLine2 String?   @map("address_line2")
  city         String
  state        String
  postalCode   String    @map("postal_code")
  country      String
  latitude     Decimal?  @db.Decimal(9, 6)
  longitude    Decimal?  @db.Decimal(9, 6)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  createdBy    String?   @map("created_by") @db.Uuid
  updatedBy    String?   @map("updated_by") @db.Uuid
  deletedBy    String?   @map("deleted_by") @db.Uuid

  patients          Patient[]
  hospitals         Hospital[]
  hospitalBranches  HospitalBranch[]
  diagnosticCenters DiagnosticCenter[]
  pharmacies        Pharmacy[]

  @@map("addresses")
}

model User {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String    @unique
  phoneNumber      String?   @map("phone_number")
  passwordHash     String    @map("password_hash")
  isActive         Boolean   @default(true) @map("is_active")
  emailVerified    Boolean   @default(false) @map("email_verified")
  phoneVerified    Boolean   @default(false) @map("phone_verified")
  twoFactorEnabled Boolean   @default(false) @map("two_factor_enabled")
  lastLoginAt      DateTime? @map("last_login_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  createdBy        String?   @map("created_by") @db.Uuid
  updatedBy        String?   @map("updated_by") @db.Uuid
  deletedBy        String?   @map("deleted_by") @db.Uuid

  userProfile             UserProfile?
  userRoles               UserRole[]
  refreshTokens           RefreshToken[]
  otps                    OTP[]
  sessions                Session[]
  documents               Document[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  auditLogs               AuditLog[]
  activityLogs            ActivityLog[]
  appointmentNotes        AppointmentNote[]

  @@map("users")
}

model UserProfile {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  firstName         String    @map("first_name")
  lastName          String    @map("last_name")
  profilePhotoId    String?   @map("profile_photo_id") @db.Uuid
  phone             String?
  preferredLanguage String    @default("en") @map("preferred_language")
  timezone          String    @default("UTC")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")
  createdBy         String?   @map("created_by") @db.Uuid
  updatedBy         String?   @map("updated_by") @db.Uuid
  deletedBy         String?   @map("deleted_by") @db.Uuid

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  profilePhoto Attachment?   @relation(fields: [profilePhotoId], references: [id], onDelete: SetNull)
  patient      Patient?
  doctor       Doctor?
  caregiver    Caregiver?
  receptionist Receptionist?

  @@map("user_profiles")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String?  @map("created_by") @db.Uuid
  updatedBy   String?  @map("updated_by") @db.Uuid

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String?  @map("created_by") @db.Uuid
  updatedBy   String?  @map("updated_by") @db.Uuid

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  createdBy    String?  @map("created_by") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  tokenHash         String   @unique @map("token_hash")
  expiresAt         DateTime @map("expires_at")
  isRevoked         Boolean  @default(false) @map("is_revoked")
  replacedByTokenId String?  @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedByToken RefreshToken?  @relation("TokenRotation", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replacements    RefreshToken[] @relation("TokenRotation")

  @@map("refresh_tokens")
}

model OTP {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  codeHash  String   @map("code_hash")
  purpose   String
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otps")
}

model Session {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  ipAddress      String   @map("ip_address")
  userAgent      String?  @map("user_agent")
  isActive       Boolean  @default(true) @map("is_active")
  lastAccessedAt DateTime @map("last_accessed_at")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Hospital {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  licenseNumber String    @unique @map("license_number")
  addressId     String    @map("address_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  createdBy     String?   @map("created_by") @db.Uuid
  updatedBy     String?   @map("updated_by") @db.Uuid
  deletedBy     String?   @map("deleted_by") @db.Uuid

  address  Address          @relation(fields: [addressId], references: [id], onDelete: Restrict)
  branches HospitalBranch[]

  @@map("hospitals")
}

model HospitalBranch {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospitalId    String    @map("hospital_id") @db.Uuid
  name          String
  licenseNumber String    @unique @map("license_number")
  addressId     String    @map("address_id") @db.Uuid
  phoneNumber   String    @map("phone_number")
  email         String
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  createdBy     String?   @map("created_by") @db.Uuid
  updatedBy     String?   @map("updated_by") @db.Uuid
  deletedBy     String?   @map("deleted_by") @db.Uuid

  hospital        Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  address         Address          @relation(fields: [addressId], references: [id], onDelete: Restrict)
  departments     Department[]
  receptionists   Receptionist[]
  doctorBranches  DoctorBranch[]
  doctorSchedules DoctorSchedule[]
  timeSlots       TimeSlot[]
  appointments    Appointment[]
  visits          Visit[]

  @@map("hospital_branches")
}

model Department {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId    String    @map("branch_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String?   @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid
  deletedBy   String?   @map("deleted_by") @db.Uuid

  branch HospitalBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  rooms  Room[]

  @@map("departments")
}

model Room {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  departmentId String     @map("department_id") @db.Uuid
  roomNumber   String     @map("room_number")
  roomType     RoomType   @map("room_type")
  roomStatus   RoomStatus @default(ACTIVE) @map("room_status")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")
  createdBy    String?    @map("created_by") @db.Uuid
  updatedBy    String?    @map("updated_by") @db.Uuid
  deletedBy    String?    @map("deleted_by") @db.Uuid

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  beds       Bed[]

  @@map("rooms")
}

model Bed {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId    String    @map("room_id") @db.Uuid
  bedNumber String    @map("bed_number")
  status    BedStatus @default(AVAILABLE)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedBy String?   @map("deleted_by") @db.Uuid

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("beds")
}

model Receptionist {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userProfileId String    @unique @map("user_profile_id") @db.Uuid
  branchId      String    @map("branch_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  createdBy     String?   @map("created_by") @db.Uuid
  updatedBy     String?   @map("updated_by") @db.Uuid
  deletedBy     String?   @map("deleted_by") @db.Uuid

  userProfile UserProfile    @relation(fields: [userProfileId], references: [id], onDelete: Restrict)
  branch      HospitalBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("receptionists")
}

model Patient {
  id                           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userProfileId                String    @unique @map("user_profile_id") @db.Uuid
  dateOfBirth                  DateTime  @map("date_of_birth")
  gender                       Gender
  bloodGroup                   String?   @map("blood_group")
  addressId                    String    @map("address_id") @db.Uuid
  emergencyContactName         String    @map("emergency_contact_name")
  emergencyContactPhone        String    @map("emergency_contact_phone")
  emergencyContactRelationship String    @map("emergency_contact_relationship")
  createdAt                    DateTime  @default(now()) @map("created_at")
  updatedAt                    DateTime  @updatedAt @map("updated_at")
  deletedAt                    DateTime? @map("deleted_at")
  createdBy                    String?   @map("created_by") @db.Uuid
  updatedBy                    String?   @map("updated_by") @db.Uuid
  deletedBy                    String?   @map("deleted_by") @db.Uuid

  userProfile       UserProfile        @relation(fields: [userProfileId], references: [id], onDelete: Restrict)
  address           Address            @relation(fields: [addressId], references: [id], onDelete: Restrict)
  patientCaregivers PatientCaregiver[]
  appointments      Appointment[]
  visits            Visit[]
  medicalRecords    MedicalRecord[]
  allergies         Allergy[]
  chronicConditions ChronicCondition[]
  vaccinations      Vaccination[]
  prescriptions     Prescription[]
  labOrders         LabOrder[]
  pharmacyOrders    PharmacyOrder[]
  invoices          Invoice[]

  @@map("patients")
}

model Doctor {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userProfileId   String    @unique @map("user_profile_id") @db.Uuid
  licenseNumber   String    @unique @map("license_number")
  qualification   String
  experienceYears Int       @default(0) @map("experience_years")
  consultationFee Decimal   @map("consultation_fee") @db.Decimal(10, 2)
  bio             String?
  rating          Decimal   @default(0.00) @db.Decimal(3, 2)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  createdBy       String?   @map("created_by") @db.Uuid
  updatedBy       String?   @map("updated_by") @db.Uuid
  deletedBy       String?   @map("deleted_by") @db.Uuid

  userProfile           UserProfile            @relation(fields: [userProfileId], references: [id], onDelete: Restrict)
  doctorBranches        DoctorBranch[]
  doctorSpecializations DoctorSpecialization[]
  doctorSchedules       DoctorSchedule[]
  timeSlots             TimeSlot[]
  appointments          Appointment[]
  visits                Visit[]
  medicalRecords        MedicalRecord[]
  vaccinations          Vaccination[]
  prescriptions         Prescription[]
  labOrders             LabOrder[]

  @@map("doctors")
}

model Caregiver {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userProfileId  String    @unique @map("user_profile_id") @db.Uuid
  licenseNumber  String?   @map("license_number")
  isProfessional Boolean   @default(false) @map("is_professional")
  specialty      String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedBy      String?   @map("deleted_by") @db.Uuid

  userProfile       UserProfile        @relation(fields: [userProfileId], references: [id], onDelete: Restrict)
  patientCaregivers PatientCaregiver[]

  @@map("caregivers")
}

model Specialization {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String?   @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid
  deletedBy   String?   @map("deleted_by") @db.Uuid

  doctorSpecializations DoctorSpecialization[]

  @@map("specializations")
}

model DoctorBranch {
  doctorId  String   @map("doctor_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  doctor Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  branch HospitalBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([doctorId, branchId])
  @@map("doctor_branches")
}

model DoctorSpecialization {
  doctorId         String   @map("doctor_id") @db.Uuid
  specializationId String   @map("specialization_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  createdBy        String?  @map("created_by") @db.Uuid

  doctor         Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  specialization Specialization @relation(fields: [specializationId], references: [id], onDelete: Cascade)

  @@id([doctorId, specializationId])
  @@map("doctor_specializations")
}

model PatientCaregiver {
  patientId        String   @map("patient_id") @db.Uuid
  caregiverId      String   @map("caregiver_id") @db.Uuid
  relationshipType String   @map("relationship_type")
  accessLevel      String   @map("access_level")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdBy        String?  @map("created_by") @db.Uuid
  updatedBy        String?  @map("updated_by") @db.Uuid

  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  caregiver Caregiver @relation(fields: [caregiverId], references: [id], onDelete: Cascade)

  @@id([patientId, caregiverId])
  @@map("patient_caregivers")
}

model DoctorSchedule {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doctorId            String    @map("doctor_id") @db.Uuid
  branchId            String    @map("branch_id") @db.Uuid
  dayOfWeek           Int       @map("day_of_week")
  startTime           String    @map("start_time")
  endTime             String    @map("end_time")
  slotDurationMinutes Int       @default(20) @map("slot_duration_minutes")
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")
  createdBy           String?   @map("created_by") @db.Uuid
  updatedBy           String?   @map("updated_by") @db.Uuid
  deletedBy           String?   @map("deleted_by") @db.Uuid

  doctor    Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  branch    HospitalBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  timeSlots TimeSlot[]

  @@map("doctor_schedules")
}

model TimeSlot {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doctorId         String    @map("doctor_id") @db.Uuid
  branchId         String    @map("branch_id") @db.Uuid
  doctorScheduleId String?   @map("doctor_schedule_id") @db.Uuid
  startAt          DateTime  @map("start_at")
  endAt            DateTime  @map("end_at")
  isReserved       Boolean   @default(false) @map("is_reserved")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  createdBy        String?   @map("created_by") @db.Uuid
  updatedBy        String?   @map("updated_by") @db.Uuid
  deletedBy        String?   @map("deleted_by") @db.Uuid

  doctor         Doctor          @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  branch         HospitalBranch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  doctorSchedule DoctorSchedule? @relation(fields: [doctorScheduleId], references: [id], onDelete: SetNull)
  appointment    Appointment?

  @@map("time_slots")
}

model Appointment {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId          String            @map("patient_id") @db.Uuid
  doctorId           String            @map("doctor_id") @db.Uuid
  branchId           String            @map("branch_id") @db.Uuid
  timeSlotId         String            @unique @map("time_slot_id") @db.Uuid
  scheduledStartAt   DateTime          @map("scheduled_start_at")
  scheduledEndAt     DateTime          @map("scheduled_end_at")
  type               VisitType
  status             AppointmentStatus @default(PENDING)
  cancellationReason String?           @map("cancellation_reason")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  deletedAt          DateTime?         @map("deleted_at")
  createdBy          String?           @map("created_by") @db.Uuid
  updatedBy          String?           @map("updated_by") @db.Uuid
  deletedBy          String?           @map("deleted_by") @db.Uuid

  patient  Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor   Doctor            @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  branch   HospitalBranch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  timeSlot TimeSlot          @relation(fields: [timeSlotId], references: [id], onDelete: Restrict)
  notes    AppointmentNote[]
  visit    Visit?
  invoices Invoice[]

  @@map("appointments")
}

model AppointmentNote {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appointmentId String    @map("appointment_id") @db.Uuid
  noteType      String    @map("note_type")
  content       String
  authorId      String    @map("author_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  createdBy     String?   @map("created_by") @db.Uuid
  updatedBy     String?   @map("updated_by") @db.Uuid
  deletedBy     String?   @map("deleted_by") @db.Uuid

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  author      User        @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@map("appointment_notes")
}

model Visit {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId     String      @map("patient_id") @db.Uuid
  doctorId      String      @map("doctor_id") @db.Uuid
  branchId      String      @map("branch_id") @db.Uuid
  appointmentId String?     @unique @map("appointment_id") @db.Uuid
  visitType     VisitType   @map("visit_type")
  visitStatus   VisitStatus @default(ACTIVE) @map("visit_status")
  checkInAt     DateTime    @map("check_in_at")
  checkOutAt    DateTime?   @map("check_out_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  deletedAt     DateTime?   @map("deleted_at")
  createdBy     String?     @map("created_by") @db.Uuid
  updatedBy     String?     @map("updated_by") @db.Uuid
  deletedBy     String?     @map("deleted_by") @db.Uuid

  patient        Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor         Doctor          @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  branch         HospitalBranch  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  appointment    Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  medicalRecords MedicalRecord[]

  @@map("visits")
}

model MedicalRecord {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId     String    @map("patient_id") @db.Uuid
  doctorId      String    @map("doctor_id") @db.Uuid
